# Local retrieval-evaluation workbench data. Final calibrated reports may be
# committed deliberately; reviewer drafts, private corpus copies, and pending
# plans are reproducible working files and can contain source text.
artifacts/reliability/eval-data/kb/*/generations/
artifacts/reliability/eval-data/knowledge/
artifacts/reliability/retrieval_eval_drafts.jsonl
artifacts/reliability/retrieval_eval_pending_plans.jsonl
artifacts/reliability/retrieval_eval_review_checklist.json
artifacts/reliability/*-pending-plans.json
# Multi-route raw evaluation contains per-case queries and retrieved source text.
# Keep only the deliberately reviewed baseline/calibration summaries eligible.
artifacts/reliability/multi-route-eval.json
# Local reliability runs persist index-migration state under the workbench root.
artifacts/reliability/eval-data/reliability/

# Node / mermaid-cli 本地渲染依赖。
