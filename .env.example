# Core paths and runtime
COGDOC_DOC_DIR=your_documents
COGDOC_DATA_DIR=./data
COGDOC_DEFAULT_DOC_ID=arch_blueprint_2026
COGDOC_MAX_UPLOAD_MB=50
COGDOC_ALLOW_MULTI=0
COGDOC_OFFLOAD_WORKERS=2
# End an SSE response after this many seconds without a worker event.
COGDOC_CHAT_STREAM_IDLE_TIMEOUT_SECONDS=300
COGDOC_RESEARCH_WORKERS=2
COGDOC_RESEARCH_RETRIEVAL_TOP_K=8
# Deep Research admission, per-phase deadlines, and durable resource budgets.
COGDOC_RESEARCH_MAX_PENDING=32
# Background Research provider admission and process-isolation limits.
COGDOC_RESEARCH_PROVIDER_WORKERS=4
COGDOC_RESEARCH_PROVIDER_MAX_PENDING=16
COGDOC_RESEARCH_PROVIDER_CALL_TIMEOUT_SECONDS=180
COGDOC_RESEARCH_LLM_PROCESS_ISOLATION_ENABLED=true
COGDOC_RESEARCH_PROVIDER_KILL_GRACE_SECONDS=0.5
COGDOC_RESEARCH_PROVIDER_IPC_MAX_BYTES=2000000
COGDOC_RESEARCH_EVIDENCE_DEADLINE_SECONDS=900
COGDOC_RESEARCH_REPORT_DEADLINE_SECONDS=1800
COGDOC_RESEARCH_PLANNING_DEADLINE_SECONDS=300
COGDOC_RESEARCH_PLANNING_WORKERS=1
COGDOC_RESEARCH_PLANNING_MAX_PENDING=8
COGDOC_RESEARCH_MAX_RETRIEVAL_QUERIES=128
COGDOC_RESEARCH_MAX_CANDIDATE_DOCS=2048
COGDOC_RESEARCH_MAX_LLM_CALLS=256
COGDOC_RESEARCH_MAX_MODEL_INPUT_CHARS=5000000

# Optional local OCR for scanned/image-only PDF pages. Disabled by default.
# The initial provider renders candidate pages with PyMuPDF and invokes Tesseract CLI.
COGDOC_OCR_ENABLED=false
COGDOC_OCR_PROVIDER=tesseract
COGDOC_OCR_BINARY=tesseract
COGDOC_OCR_LANGUAGES=eng+chi_sim
COGDOC_OCR_DPI=300
COGDOC_OCR_MIN_NATIVE_CHARS=40
COGDOC_OCR_MAX_PAGES=100
COGDOC_OCR_PAGE_TIMEOUT_SECONDS=30
# false: continue ingestion with the native-text result when OCR fails;
# true: fail ingestion when OCR is required but unavailable or unsuccessful.
# /health/ready reports disabled OCR as disabled. If enabled but the binary is
# missing, optional OCR is degraded while the service stays ready; required OCR
# makes readiness fail with HTTP 503.
COGDOC_OCR_REQUIRED=false

# 分层记忆预算不影响完整展示历史
COGDOC_MEMORY_SHORT_MESSAGE_LIMIT=12
COGDOC_MEMORY_SHORT_CHAR_LIMIT=6000
COGDOC_MEMORY_MID_CHAR_LIMIT=4000
COGDOC_MEMORY_LONG_FACT_LIMIT=64
COGDOC_MEMORY_CONTEXT_LONG_LIMIT=8
COGDOC_MEMORY_RETRIEVAL_ENABLED=true
COGDOC_MEMORY_SEMANTIC_ENABLED=true
COGDOC_MEMORY_RETRIEVAL_SHORT_LIMIT=8
COGDOC_MEMORY_RETRIEVAL_MID_LIMIT=4
COGDOC_MEMORY_RETRIEVAL_RECENT_PIN=4
COGDOC_MEMORY_SEMANTIC_INCLUDE_SHORT=false
COGDOC_MEMORY_RRF_K=60
COGDOC_MEMORY_RECENCY_WEIGHT=1.0
COGDOC_MEMORY_LEXICAL_WEIGHT=1.4
COGDOC_MEMORY_SEMANTIC_WEIGHT=1.6
COGDOC_MEMORY_IMPORTANCE_WEIGHT=0.8
COGDOC_MEMORY_MID_PRIORITY_WEIGHT=0.8

# API and frontend. Persistent email/password accounts are opt-in so existing
# local and API-key deployments keep their current behavior. Set account auth
# to true for a production individual/team deployment; protected /v1 routes
# then accept opaque login-session Bearer tokens as well as explicitly
# configured service API keys. `make frontend` loads this file without
# overriding values already exported by the shell.
COGDOC_ACCOUNT_AUTH_ENABLED=false
# Allow public /v1/auth/register while account auth is enabled. Enterprises
# should normally bootstrap the first owner, invite remaining users, then set
# this to false. Invite acceptance remains available.
COGDOC_SELF_REGISTRATION_ENABLED=true
# Opaque login-session and one-time invitation lifetimes (seconds).
COGDOC_AUTH_SESSION_TTL_SECONDS=2592000
COGDOC_AUTH_INVITE_TTL_SECONDS=604800
# Consecutive failed password logins lock the account for this many seconds.
COGDOC_AUTH_MAX_FAILED_LOGINS=5
COGDOC_AUTH_LOCKOUT_SECONDS=900

# Static/service API-key compatibility. When account auth is false,
# authentication is disabled only when API_KEYS, API_PRINCIPALS, and
# EVAL_REVIEW_API_KEYS are all empty. Legacy keys remain default-workspace
# admins for backward compatibility.
COGDOC_API_KEYS=
# Preferred team-workspace identity map (one-line JSON):
# {"raw-key":{"tenant_id":"team-a","subject_id":"alice","role":"editor"}}
# Roles: owner, admin, editor, reviewer, viewer.
COGDOC_API_PRINCIPALS=
# Evidence-eval curation plus Research review/publication stay disabled unless
# an explicit reviewer/admin/owner principal or this legacy independent key set
# is configured. Legacy review keys also receive default-workspace admin access.
COGDOC_EVAL_REVIEW_API_KEYS=
COGDOC_API_URL=http://localhost:8000
# Frontend outbound service credential, not a server-side allowlist. When this
# singular variable is present in the Streamlit process, browsers without a
# human session deliberately enter API-key mode and skip the account login UI.
# Keep it empty on a shared/multi-user frontend; configure server credentials
# with the plural API_KEYS/API_PRINCIPALS variables and let humans sign in.
COGDOC_API_KEY=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=120
# Hard per-workspace quotas; zero means unlimited.
COGDOC_TENANT_MAX_KNOWLEDGE_BASES=0
COGDOC_TENANT_MAX_DOCUMENTS=0
COGDOC_TENANT_MAX_STORAGE_MB=0

# Logging, traces, webhooks, and feedback
COGDOC_LOG_LEVEL=INFO
COGDOC_LOG_FILE=logs/cogdoc.jsonl
COGDOC_LOG_TO_CONSOLE=false
COGDOC_TRACE_ENABLED=true
COGDOC_TRACE_DIR=logs/traces
COGDOC_WEBHOOK_URL=
COGDOC_WEBHOOK_SECRET=
COGDOC_WEBHOOK_TIMEOUT_SECONDS=3
# Unified persistence backend. Keep jsonl until migrate_state.py dry-run, apply,
# and verify-only all succeed; only then change this value to sqlite.
COGDOC_STATE_BACKEND=jsonl
# Legacy compatibility for deployments using the standalone feedback backend.
# Unified sqlite state is selected by COGDOC_STATE_BACKEND instead.
COGDOC_FEEDBACK_STORE=jsonl
COGDOC_DERIVED_KNOWLEDGE_INDEX_AUTO_REFRESH=false

# Default cloud OpenAI-compatible backend
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key
LLM_STRUCTURED_OUTPUT_METHOD=auto
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_JUDGE_ENABLED=true
# 留空时复用 LLM_MODEL_NAME；生产建议配置独立、更强的阅卷模型。
LLM_JUDGE_MODEL_NAME=
LLM_JUDGE_TEMPERATURE=0.0

# Cloud node model overrides. Empty values fall back to LLM_MODEL_NAME.
# Use a different evaluator model where your endpoint exposes one, so generation
# and evidence review do not share exactly the same model bias.
# Backend values: default (follow request), cloud, or local.
LLM_ROUTER_BACKEND=default
LLM_ROUTER_MODEL_NAME=
LLM_QUERY_REWRITER_BACKEND=default
LLM_QUERY_REWRITER_MODEL_NAME=
LLM_RESEARCH_PLANNER_BACKEND=default
LLM_RESEARCH_PLANNER_MODEL_NAME=
LLM_SOURCE_RESOLVER_BACKEND=default
LLM_SOURCE_RESOLVER_MODEL_NAME=
LLM_EVIDENCE_VERIFIER_BACKEND=default
LLM_EVIDENCE_VERIFIER_MODEL_NAME=
LLM_CLAIM_VERIFIER_BACKEND=default
LLM_CLAIM_VERIFIER_MODEL_NAME=
LLM_CLAIM_REPAIRER_BACKEND=default
LLM_CLAIM_REPAIRER_MODEL_NAME=
LLM_QA_GENERATOR_BACKEND=default
LLM_QA_GENERATOR_MODEL_NAME=
LLM_SUMMARY_GENERATOR_BACKEND=default
LLM_SUMMARY_GENERATOR_MODEL_NAME=
LLM_COMPARE_PROFILE_BACKEND=default
LLM_COMPARE_PROFILE_MODEL_NAME=
LLM_COMPARE_CONCLUSION_BACKEND=default
LLM_COMPARE_CONCLUSION_MODEL_NAME=

# Local OpenAI-compatible Ollama backend
OLLAMA_MODEL_NAME=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1

# Local node model overrides. Empty values fall back to OLLAMA_MODEL_NAME.
OLLAMA_ROUTER_MODEL_NAME=
OLLAMA_QUERY_REWRITER_MODEL_NAME=
OLLAMA_RESEARCH_PLANNER_MODEL_NAME=
OLLAMA_SOURCE_RESOLVER_MODEL_NAME=
OLLAMA_EVIDENCE_VERIFIER_MODEL_NAME=
OLLAMA_CLAIM_VERIFIER_MODEL_NAME=
OLLAMA_CLAIM_REPAIRER_MODEL_NAME=
OLLAMA_QA_GENERATOR_MODEL_NAME=
OLLAMA_SUMMARY_GENERATOR_MODEL_NAME=
OLLAMA_COMPARE_PROFILE_MODEL_NAME=
OLLAMA_COMPARE_CONCLUSION_MODEL_NAME=

# Retrieval, reranking, abstention, evidence verification, and claim verification
QA_RETRIEVAL_TOP_K=9
QA_RAG_VECTOR_ROUTE_WEIGHT=1.0
QA_RAG_BM25_ROUTE_WEIGHT=1.0
QA_DERIVED_KNOWLEDGE_VECTOR_ROUTE_WEIGHT=0.9
QA_DERIVED_KNOWLEDGE_LEXICAL_ROUTE_WEIGHT=0.8
QA_RETRIEVAL_DOCS_PER_ROUTE=1
QA_RERANK_TOP_N=3
QA_RERANK_DOCS_PER_ROUTE=1
QA_RERANK_MAX_CANDIDATES=12
QA_RERANK_ON_CPU=false
QA_RERANK_DOCS_PER_REQUIREMENT=2
QA_QUERY_REWRITE_FAST_PATH_ENABLED=true
QA_PARENT_CONTEXT_ENABLED=true
QA_PARENT_CONTEXT_MAX_CHUNKS=5
QA_PARENT_CONTEXT_MAX_CHARS=3600
QA_EVIDENCE_SPAN_ENABLED=true
QA_EVIDENCE_SPAN_MAX_CHARS_PER_DOC=420
QA_EVIDENCE_SPAN_CONTEXT_SENTENCES=1
# One deterministic QA generation-evidence budget. Counts the exact rendered
# evidence blocks (tags, IDs, locators, text, separators); excludes system/history/query.
QA_EVIDENCE_PACK_MAX_DOCS=8
QA_EVIDENCE_PACK_MAX_CHARS=7200
QA_ABSTAIN_ENABLED=true
# Calibrated on the versioned v3 evaluation index; rerun calibration after
# changing the corpus, parser, embedding model, or retrieval fusion.
QA_ABSTAIN_MAX_VECTOR_DISTANCE=0.7117711305618286
QA_ABSTAIN_MIN_BM25_SCORE=12.328925491936891
# Deprecated compatibility fallback for both split thresholds below. Leave
# unset in new deployments; it is still accepted when upgrading an old .env.
# QA_ABSTAIN_MIN_KNOWLEDGE_SCORE=0.5
QA_ABSTAIN_MIN_KNOWLEDGE_VECTOR_SCORE=0.5
QA_ABSTAIN_MIN_KNOWLEDGE_LEXICAL_SCORE=0.5
QA_ABSTAIN_ALLOW_MISSING_SIGNALS=false
QA_EVIDENCE_VERIFY_ENABLED=true
QA_EVIDENCE_VERIFY_MAX_DOCS=3
QA_EVIDENCE_VERIFY_MAX_CHARS_PER_DOC=1600
QA_EVIDENCE_VERIFY_BORDERLINE_MIN_SCORE=0.75
# Agent-independent closed-set verifier for Summary/Compare evidence units.
EVIDENCE_UNIT_VERIFY_ENABLED=true
EVIDENCE_UNIT_VERIFY_MAX_CHARS_PER_DOC=1200
EVIDENCE_UNIT_VERIFY_MAX_UNITS_PER_BATCH=8
QA_RETRIEVAL_MAX_QUERIES=7
QA_ADAPTIVE_RETRIEVAL_ENABLED=true
QA_ADAPTIVE_RETRIEVAL_MAX_RETRIES=1
QA_ADAPTIVE_RETRIEVAL_TOP_K_MULTIPLIER=2.0
QA_ADAPTIVE_RETRIEVAL_MAX_TOP_K=36

# Opt-in post-generation claim-level semantic gate. When enabled, verifier or
# repair failures reject the candidate answer instead of releasing it.
CLAIM_VERIFICATION_ENABLED=false
CLAIM_VERIFICATION_MAX_CLAIMS=40
CLAIM_VERIFICATION_MAX_CLAIMS_PER_BATCH=8
CLAIM_VERIFICATION_MAX_DOCS_PER_BATCH=12
CLAIM_VERIFICATION_MAX_CHARS_PER_DOC=1600
CLAIM_VERIFICATION_MAX_REPAIR_ATTEMPTS=1
HYBRID_RRF_K=60
CLOUD_SECTION_MAX_WORKERS=6

# Local model resource controls
EMBEDDER_MIN_CUDA_FREE_MB=800
RERANKER_MIN_CUDA_FREE_MB=2800
COGDOC_TORCH_NUM_THREADS=2
COGDOC_EMBEDDER_MAX_CONCURRENCY=1
COGDOC_RERANKER_MAX_CONCURRENCY=1

# Evaluation datasets
HF_TOKEN=
COGDOC_EVAL_SET=eval/retrieval_eval.jsonl
COGDOC_EVAL_EXAMPLE_SET=eval/retrieval_eval.example.jsonl
COGDOC_QUALITY_EVAL_SET=eval/quality_eval.jsonl
COGDOC_QUALITY_EVAL_EXAMPLE_SET=eval/quality_eval.example.jsonl
